# Auto-detect text files and normalize line endings
* text=auto

# Explicit text files with LF normalization for cross-platform CI
*.py text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.css text eol=lf
*.html text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.ini text eol=lf

# Binary files
*.db binary
*.png binary
*.jpg binary
*.jpeg binary
*.wav binary
*.mp3 binary
*.ico binary
