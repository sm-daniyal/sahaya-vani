# ── SahayaVaani Backend Environment Variables ─────────────────────────────────
# Copy this file to .env and fill in your values.

# Gnani API credentials
GNANI_API_KEY=your_gnani_api_key_here

# STT / TTS endpoints (defaults shown — change only if Gnani updates their URLs)
STT_WS_URL=wss://api.vachana.ai/stt/v3/stream
TTS_WS_URL=wss://api.vachana.ai/tts/v2/stream
STT_LANG_CODE=kn-IN
TTS_VOICE=kannada_female_1

# LLM — Gnani Evon v3.3 (local vLLM or Colab/cloud GPU endpoint)
EVON_ENABLED=true
VLLM_BASE_URL=http://localhost:8000/v1
EVON_MODEL_NAME=gnani/evon-v3.3
EVON_API_KEY=EMPTY
EVON_MAX_TOKENS=512
EVON_TEMPERATURE=0.3
EVON_TIMEOUT=8.0

# Optional Fallback LLM (Gemini Flash via Google OpenAI-compatible endpoint)
GEMINI_API_KEY=your_gemini_api_key_here

# Audio settings
SAMPLE_RATE=16000
FRAME_SIZE=1024
NOISE_GATE_THRESHOLD=400

# VAD
VAD_AGGRESSIVENESS=2
VAD_MIN_SILENCE_MS=550

# Database
DB_PATH=emr.db
DB_URL=sqlite+aiosqlite:///emr.db

# Server
HOST=0.0.0.0
PORT=8080
DEBUG=false

# CORS (comma-separated if multiple)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
